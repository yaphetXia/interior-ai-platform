# ========================================
# Google AI Studio (Gemini) 图像生成 API 配置
# ========================================

# Google AI Studio API 端点
# 使用 Google Generative Language API
VITE_GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# Google AI Studio API Key（仅用于开发测试，生产环境应在 Edge Function 中配置）
# 获取位置: Google AI Studio (https://aistudio.google.com/) > Get API Key
# 注意：此 Key 不应该暴露在前端，最终会移到 Supabase Edge Function 中
VITE_GEMINI_API_KEY=AIzaSyAmKzx2r4ovCcjPZq79kX-7nk3VipPgK2Q

# 图像生成模型名称
# 使用 Google 最新的图像生成模型 Gemini 2.5 Flash Image
VITE_GEMINI_MODEL=gemini-2.5-flash-image

# ========================================
# 其他配置
# ========================================

# 应用环境
VITE_APP_ENV=development

# API超时时间（毫秒）
VITE_API_TIMEOUT=120000

# 生成图片的最大数量
VITE_MAX_IMAGES_PER_GENERATION=4

# ========================================
# 星空 API 配置（OpenAI 兼容格式，代理访问 Gemini）
# ========================================

# 星空 API 端点
VITE_XINGKONG_API_ENDPOINT=https://api.wfei.site

# 星空 API Key
VITE_XINGKONG_API_KEY=your-xingkong-api-key-here

